{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "center": true,
        "height": 500,
        "maximizable": false,
        "resizable": false,
        "title": "DNF 连发工具",
        "width": 910
      },
      {
        "label": "mini",
        "url": "mini.html",
        "center": true,
        "height": 400,
        "width": 320,
        "title": "切换配置",
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": false,
        "skipTaskbar": true,
        "transparent": false
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "pnpm run build:web",
    "beforeDevCommand": "pnpm run dev:web",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "identifier": "cn.yojigen.dnfautofire",
  "productName": "DNF AutoFire",
  "version": "0.1.0"
}
