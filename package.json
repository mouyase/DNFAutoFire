{
  "name": "dnf-auto-fire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "oxlint": "oxlint --type-aware",
    "eslint": "eslint .",
    "lint": "oxlint --type-aware && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "check": "tsc --noEmit && oxlint --type-aware && eslint . && oxfmt --check src",
    "rust:check": "cd src-tauri && cargo check",
    "rust:clippy": "cd src-tauri && cargo clippy -- -D warnings",
    "rust:fmt": "cd src-tauri && cargo fmt",
    "rust:fmt:check": "cd src-tauri && cargo fmt -- --check",
    "rust:test": "cd src-tauri && cargo test",
    "rust:build": "cd src-tauri && cargo build",
    "rust:build:release": "cd src-tauri && cargo build --release",
    "check:all": "pnpm check && pnpm rust:clippy && pnpm rust:fmt:check",
    "clean": "rm -rf node_modules dist src-tauri/target",
    "clean:dist": "rm -rf dist src-tauri/target",
    "clean:node": "rm -rf node_modules"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "babel-plugin-react-compiler": "^19.0.0-beta-df7b47d-20241124",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "oxfmt": "^0.17.0",
    "oxlint": "^1.32.0",
    "oxlint-tsgolint": "^0.9.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0-beta.8",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.3"
  }
}
